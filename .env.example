# Copy to .env for running on your computer (npm run dev). On Vercel, set these in Project → Settings → Environment Variables.

# Postgres connection string. On Vercel: add a Neon database from the Storage tab and this is filled in for you.
# Leave it empty on your computer to use the built-in local database (saved in .data/pglite).
DATABASE_URL=

# Long random text that signs the login cookies. Required on Vercel. Example: run  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first admin login, created automatically the first time the app starts (only if no admin exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Shubhanshu Singh
